# ==============================================================================
# ZEN AI Assistant - Environment Configuration
# ==============================================================================

# AI Provider Configuration
# Choose primary provider: gemini | openai | anthropic | ollama
ZEN_AI_PROVIDER=gemini
ZEN_AI_MODEL=gemini-3.6-flash

# API Keys (Provide the one corresponding to your chosen provider)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Ollama Configuration (if using local provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Voice Configuration
ZEN_VOICE_ENABLED=true
ZEN_VOICE_ENGINE=edge_tts
ZEN_VOICE_NAME=en-US-GuyNeural
ZEN_VOICE_SPEED=+0%
ZEN_WAKE_WORD_ENABLED=false
ZEN_WAKE_PHRASE=hey zen

# System & Safety Settings
ZEN_CONFIRMATION_REQUIRED=true
ZEN_AUTO_OPEN_VSCODE=true
ZEN_MAX_CODING_ITERATIONS=5
ZEN_WORKSPACE_DIR=workspace
ZEN_DATA_DIR=data
ZEN_LOG_LEVEL=INFO
